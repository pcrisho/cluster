{
  "name": "@cluster/docs",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3004 --turbopack",
    "build": "pnpm check:content && next build && pagefind --site out/en --output-subdir pagefind && pagefind --site out/es --output-subdir pagefind && pnpm check:links",
    "start": "next start -p 3004",
    "lint": "eslint && node ../web/scripts/lint-tokens.mjs --root .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint:tokens": "node ../web/scripts/lint-tokens.mjs --root .",
    "check:content": "tsx scripts/check-content.ts",
    "check:links": "tsx scripts/check-links.ts"
  },
  "dependencies": {
    "@cluster/theme": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.16.0",
    "next": "16.4.6",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/jest": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.6",
    "jest": "^30.4.2",
    "pagefind": "^1.6.0",
    "postcss": "^8",
    "tailwindcss": "^4.2.1",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
