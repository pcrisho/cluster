FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/site/package.json ./apps/site/
COPY packages/theme/package.json ./packages/theme/
RUN pnpm install --frozen-lockfile --filter @cluster/site... --filter @cluster/theme

FROM base AS builder
# Build args for public site URLs inlined at build time:
ARG NEXT_PUBLIC_DEMO_URL
ARG NEXT_PUBLIC_GITHUB_URL
ARG NEXT_PUBLIC_DOCS_URL
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3003
ENV NEXT_PUBLIC_DEMO_URL=$NEXT_PUBLIC_DEMO_URL \
    NEXT_PUBLIC_GITHUB_URL=$NEXT_PUBLIC_GITHUB_URL \
    NEXT_PUBLIC_DOCS_URL=$NEXT_PUBLIC_DOCS_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/site/node_modules ./apps/site/node_modules
COPY --from=deps /app/packages/theme/node_modules ./packages/theme/node_modules
COPY . .
RUN pnpm --filter @cluster/theme build && pnpm --filter @cluster/site build

FROM nginx:alpine AS runner
COPY docker/nginx-site.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/site/out /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
