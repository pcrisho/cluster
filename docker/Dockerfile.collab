FROM node:24.22.3-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.34.9 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/collab/package.json ./apps/collab/
COPY packages/editor-schema/package.json ./packages/editor-schema/
RUN pnpm install --frozen-lockfile --filter @cluster/collab... --filter @cluster/editor-schema

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/collab/node_modules ./apps/collab/node_modules
COPY --from=deps /app/packages/editor-schema/node_modules ./packages/editor-schema/node_modules
COPY . .
RUN pnpm --filter @cluster/editor-schema build && pnpm --filter @cluster/collab build

# shortcut: ships the full (dev included) node_modules, like the API image. Switch to
# `pnpm deploy --prod` if image size matters.
FROM node:24.22.3-alpine AS runner
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 collab
WORKDIR /app
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/collab/node_modules ./apps/collab/node_modules
COPY --from=builder /app/apps/collab/package.json ./apps/collab/package.json
COPY --from=builder /app/apps/collab/dist ./apps/collab/dist
COPY --from=builder /app/packages/editor-schema/package.json ./packages/editor-schema/package.json
COPY --from=builder /app/packages/editor-schema/dist ./packages/editor-schema/dist
COPY --from=builder /app/packages/editor-schema/node_modules ./packages/editor-schema/node_modules
USER collab
WORKDIR /app/apps/collab
EXPOSE 3002
# The library closes on SIGTERM and saves what is pending first (see stop_grace_period).
CMD ["node", "dist/main.js"]
