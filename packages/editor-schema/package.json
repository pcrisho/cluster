{
  "name": "@cluster/editor-schema",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-document": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extension-paragraph": "^3.35.0",
    "@tiptap/extension-task-item": "^3.35.0",
    "@tiptap/extension-task-list": "^3.35.0",
    "@tiptap/extension-text": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "markdown-it": "^14.3.3"
  },
  "sideEffects": false
}
