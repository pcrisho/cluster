# ─── App ───────────────────────────────────────
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000

# ─── Database (PostgreSQL) ─────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cluster
POSTGRES_USER=cluster
POSTGRES_PASSWORD=cluster
# The API connects as cluster_app (DATABASE_URL, subject to row-level security) and, for auth, instance and
# cross-organization paths, as cluster_system (DATABASE_SYSTEM_URL: bypasses RLS, DML only, owns nothing).
# Migrations, the seed and backups use the owner (DATABASE_OWNER_URL), which stays out of the API container.
# `pnpm --filter @cluster/api db:roles` creates both roles with these passwords.
CLUSTER_APP_PASSWORD=cluster_app
CLUSTER_SYSTEM_PASSWORD=cluster_system
DATABASE_URL=postgresql://cluster_app:${CLUSTER_APP_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_SYSTEM_URL=postgresql://cluster_system:${CLUSTER_SYSTEM_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_OWNER_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── Redis ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis keeps only the rate-limit counters (sessions and links live in Postgres). Required by
# docker-compose.yml, which refuses to start without it; dev compose runs without one.
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# ─── Storage: SeaweedFS (S3-compatible) ────────
# The storage container and the API share these keys (the storage container creates its one identity from them).
STORAGE_HOST=localhost
STORAGE_PORT=9000
STORAGE_MASTER_PORT=9333
STORAGE_BUCKET=cluster
STORAGE_ACCESS_KEY=cluster-storage
STORAGE_SECRET_KEY=cluster-storage-secret
STORAGE_USE_SSL=false

# ─── Collab (realtime editing service) ─────────
COLLAB_URL=http://localhost:3002
COLLAB_PORT=3002
# Comma-separated browser origins allowed to open WebSockets
COLLAB_ALLOWED_ORIGINS=http://localhost:3000
COLLAB_API_URL=http://localhost:3001/api/v1
# Shared secret between the API and collab (X-Collab-Secret). Generate a long random value,
# e.g. `openssl rand -hex 32`. Empty means every internal collab call fails, and `docker compose`
# refuses to start. Do not export a different one in your shell: it wins over this file.
COLLAB_INTERNAL_SECRET=
COLLAB_MAX_DOC_BYTES=10485760

# ─── Reverse proxy ─────────────────────────────
# Express "trust proxy": how many proxies sit in front of the API (e.g. 1 behind one nginx or
# Caddy) or a list of their addresses. Empty in dev. Per-IP rate limits (public certificate
# verification) need it to see the client's IP instead of the proxy's.
TRUST_PROXY=

# ─── Resources (docker-compose.yml) ────────────
# Memory limit of the API container. 1G leaves room for lesson video uploads and about 40 people
# watching at once (spike S2, docs/specs/grow/lms/evidence/s2-video/); raise it for more.
API_MEMORY_LIMIT=1G
# Where lesson videos wait (up to 1 GB each, at most 3 at once) while they are stored. Empty: the
# system temp folder, which is memory on hosts where /tmp is tmpfs. Point it at a disk with room
# (in Docker, a mounted volume); the API refuses an upload that would leave under 512 MB free there.
UPLOAD_TMP_DIR=

# ─── WebSockets (Socket.IO) ────────────────────
WS_CORS_ORIGIN=http://localhost:3000

# ─── Auth / JWT ────────────────────────────────
JWT_SECRET=change-me-in-production
# Rotation: move the old value here and set a new JWT_SECRET; tokens signed with it keep
# verifying until they expire. Leave empty otherwise.
JWT_SECRET_PREVIOUS=
# Keys the sign-in lockout and encrypts 2FA secrets; required in production, different from JWT_SECRET
# (`openssl rand -hex 32`). Changing it invalidates every enrolled authenticator app.
AUTH_SECRET_KEY=
# Days `auth:sweep` keeps rows of auth_events (sign-in log); default 365.
AUTH_EVENTS_RETENTION_DAYS=

# ─── Web app ───────────────────────────────────
# Public URL of the web app, used in email links (invitations, password resets).
WEB_URL=http://localhost:3000
# Public API URLs used by the browser. Inlined into the web image at build time
# (docker compose build); in dev the web falls back to localhost:3001.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001
# Public WebSocket URL of the collab service (wss://... behind HTTPS). Same rule: inlined at build time.
NEXT_PUBLIC_COLLAB_URL=ws://localhost:3002
# API URL the web server itself uses (the instance's default language on a first visit).
# Read at run time; falls back to NEXT_PUBLIC_API_URL. In Docker compose it is the api service.
# API_INTERNAL_URL=http://api:3001/api/v1

# ─── Email (SMTP) ──────────────────────────────
# Dev/tests: Mailpit (docker-compose.dev.yml), inbox at http://localhost:8025
# Production with Resend: SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=resend SMTP_PASS=<api key>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Cluster <no-reply@cluster.local>
# Empty SMTP_HOST = mail off: nothing is sent and admins hand over access links or initial passwords instead.
# Invitations queued for an area go out at this pace (0 pauses the sender).
MAIL_INVITES_PER_MINUTE=60
MAILPIT_UI_PORT=8025

# ─── Instance bootstrap ────────────────────────
# On first boot, if no superadmin exists, the API creates one with these
# credentials (and an organization named SUPERADMIN_ORG_NAME). Leave empty to skip.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_ORG_NAME=Default
